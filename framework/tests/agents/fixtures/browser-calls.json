{
  "about": "Shared cases for every browser implementation of a server tool call (AGENT-014, AGENT-015, AGENT-016): the Live runtime, the three kits and the WebAssembly crate. The paths mirror the MCP dispatcher's path rules (framework/src/agents/dispatch.rs), except that a browser refuses a `.` or `..` path value, which its URL parser would resolve before the request leaves, and that a GET call sends every scalar argument, path arguments included, in the query, which a form request on GET reads. The results mirror its result mapping (framework/src/agents/mcp/tools.rs) without resultType, plus the rows only a browser meets, each marked browserOnly. Read it; do not edit it in a lane.",
  "paths": [
    {
      "name": "a number fills its segment",
      "method": "POST",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": 7
      },
      "expected": {
        "url": "/posts/7",
        "body": {
          "post": 7
        }
      }
    },
    {
      "name": "a boolean fills its segment",
      "method": "POST",
      "path": [
        {
          "text": "/flags/"
        },
        {
          "param": "on",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "on": true
      },
      "expected": {
        "url": "/flags/true",
        "body": {
          "on": true
        }
      }
    },
    {
      "name": "a decimal keeps its digits",
      "method": "POST",
      "path": [
        {
          "text": "/rates/"
        },
        {
          "param": "rate",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "rate": 1.5
      },
      "expected": {
        "url": "/rates/1.5",
        "body": {
          "rate": 1.5
        }
      }
    },
    {
      "name": "reserved characters are encoded",
      "method": "POST",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": "a b/c?d#e%f"
      },
      "expected": {
        "url": "/posts/a%20b%2Fc%3Fd%23e%25f",
        "body": {
          "post": "a b/c?d#e%f"
        }
      }
    },
    {
      "name": "sub-delims a URI component encoder leaves alone are encoded",
      "method": "POST",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": "it's (x)*!~"
      },
      "expected": {
        "url": "/posts/it%27s%20%28x%29%2A%21~",
        "body": {
          "post": "it's (x)*!~"
        }
      }
    },
    {
      "name": "gen-delims and the rest of the set are encoded",
      "method": "POST",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": ":@[]$&+,;=\"<>\\^`{|}"
      },
      "expected": {
        "url": "/posts/%3A%40%5B%5D%24%26%2B%2C%3B%3D%22%3C%3E%5C%5E%60%7B%7C%7D",
        "body": {
          "post": ":@[]$&+,;=\"<>\\^`{|}"
        }
      }
    },
    {
      "name": "non-ASCII is encoded as UTF-8",
      "method": "POST",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": "caf\u00e9 \u5de5"
      },
      "expected": {
        "url": "/posts/caf%C3%A9%20%E5%B7%A5",
        "body": {
          "post": "caf\u00e9 \u5de5"
        }
      }
    },
    {
      "name": "unreserved characters stay as they are",
      "method": "POST",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": "A-z_0.9~"
      },
      "expected": {
        "url": "/posts/A-z_0.9~",
        "body": {
          "post": "A-z_0.9~"
        }
      }
    },
    {
      "name": "a segment of two dots is refused",
      "method": "POST",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": ".."
      },
      "expected": {
        "error": {
          "content": [
            {
              "type": "text",
              "text": "Invalid input: the path parameter `post` cannot be `.` or `..`, or hold one as a part, because a browser resolves it as a step of the path."
            }
          ],
          "isError": true
        }
      }
    },
    {
      "name": "a segment of one dot is refused",
      "method": "POST",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": "."
      },
      "expected": {
        "error": {
          "content": [
            {
              "type": "text",
              "text": "Invalid input: the path parameter `post` cannot be `.` or `..`, or hold one as a part, because a browser resolves it as a step of the path."
            }
          ],
          "isError": true
        }
      }
    },
    {
      "name": "a segment of three dots is encoded",
      "method": "POST",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": "..."
      },
      "expected": {
        "url": "/posts/%2E%2E%2E",
        "body": {
          "post": "..."
        }
      }
    },
    {
      "name": "dots inside a segment stay",
      "method": "POST",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": "a.b"
      },
      "expected": {
        "url": "/posts/a.b",
        "body": {
          "post": "a.b"
        }
      }
    },
    {
      "name": "a catch-all keeps its slashes and encodes each part",
      "method": "POST",
      "path": [
        {
          "text": "/files/"
        },
        {
          "param": "path",
          "optional": false,
          "catchAll": true
        }
      ],
      "arguments": {
        "path": "docs/a b/c.d"
      },
      "expected": {
        "url": "/files/docs/a%20b/c.d",
        "body": {
          "path": "docs/a b/c.d"
        }
      }
    },
    {
      "name": "a catch-all with a dot part is refused",
      "method": "POST",
      "path": [
        {
          "text": "/files/"
        },
        {
          "param": "path",
          "optional": false,
          "catchAll": true
        }
      ],
      "arguments": {
        "path": "docs/../c"
      },
      "expected": {
        "error": {
          "content": [
            {
              "type": "text",
              "text": "Invalid input: the path parameter `path` cannot be `.` or `..`, or hold one as a part, because a browser resolves it as a step of the path."
            }
          ],
          "isError": true
        }
      }
    },
    {
      "name": "an absent optional drops its slash",
      "method": "GET",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "page",
          "optional": true,
          "catchAll": false
        }
      ],
      "arguments": {},
      "expected": {
        "url": "/posts",
        "body": null
      }
    },
    {
      "name": "a null optional drops its slash",
      "method": "GET",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "page",
          "optional": true,
          "catchAll": false
        }
      ],
      "arguments": {
        "page": null
      },
      "expected": {
        "url": "/posts",
        "body": null
      }
    },
    {
      "name": "an empty optional drops its slash",
      "method": "GET",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "page",
          "optional": true,
          "catchAll": false
        }
      ],
      "arguments": {
        "page": ""
      },
      "expected": {
        "url": "/posts",
        "body": null
      }
    },
    {
      "name": "a dropped optional at the root leaves the root",
      "method": "GET",
      "path": [
        {
          "text": "/"
        },
        {
          "param": "page",
          "optional": true,
          "catchAll": false
        }
      ],
      "arguments": {},
      "expected": {
        "url": "/",
        "body": null
      }
    },
    {
      "name": "a present optional fills its segment",
      "method": "GET",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "page",
          "optional": true,
          "catchAll": false
        }
      ],
      "arguments": {
        "page": 3
      },
      "expected": {
        "url": "/posts/3?page=3",
        "body": null
      }
    },
    {
      "name": "a missing required parameter is an error",
      "method": "POST",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {},
      "expected": {
        "error": {
          "content": [
            {
              "type": "text",
              "text": "Invalid input: the path parameter `post` is missing."
            }
          ],
          "isError": true
        }
      }
    },
    {
      "name": "an empty required parameter is an error",
      "method": "POST",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": ""
      },
      "expected": {
        "error": {
          "content": [
            {
              "type": "text",
              "text": "Invalid input: the path parameter `post` is missing."
            }
          ],
          "isError": true
        }
      }
    },
    {
      "name": "a structured path value is an error",
      "method": "POST",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": {
          "id": 1
        }
      },
      "expected": {
        "error": {
          "content": [
            {
              "type": "text",
              "text": "Invalid input: the path parameter `post` must be a string, a number or a boolean."
            }
          ],
          "isError": true
        }
      }
    },
    {
      "name": "GET sends the other scalars in the query, in argument order",
      "method": "GET",
      "path": [
        {
          "text": "/search"
        }
      ],
      "arguments": {
        "q": "a b&c",
        "page": 2,
        "draft": false
      },
      "expected": {
        "url": "/search?q=a+b%26c&page=2&draft=false",
        "body": null
      }
    },
    {
      "name": "GET sends path arguments in the query too",
      "method": "GET",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": 3,
        "q": "caf\u00e9"
      },
      "expected": {
        "url": "/posts/3?post=3&q=caf%C3%A9",
        "body": null
      }
    },
    {
      "name": "GET with only a path argument still sends it in the query",
      "method": "GET",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": 3
      },
      "expected": {
        "url": "/posts/3?post=3",
        "body": null
      }
    },
    {
      "name": "GET with an absent optional sends no query",
      "method": "GET",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "page",
          "optional": true,
          "catchAll": false
        }
      ],
      "arguments": {},
      "expected": {
        "url": "/posts",
        "body": null
      }
    },
    {
      "name": "GET sends an empty string that is not a path argument",
      "method": "GET",
      "path": [
        {
          "text": "/search"
        }
      ],
      "arguments": {
        "q": ""
      },
      "expected": {
        "url": "/search?q=",
        "body": null
      }
    },
    {
      "name": "GET leaves a null argument out",
      "method": "GET",
      "path": [
        {
          "text": "/search"
        }
      ],
      "arguments": {
        "q": "x",
        "page": null
      },
      "expected": {
        "url": "/search?q=x",
        "body": null
      }
    },
    {
      "name": "GET refuses a structured argument",
      "method": "GET",
      "path": [
        {
          "text": "/search"
        }
      ],
      "arguments": {
        "q": "x",
        "filters": {
          "draft": true
        }
      },
      "expected": {
        "error": {
          "content": [
            {
              "type": "text",
              "text": "Invalid input: the argument `filters` must be a string, a number or a boolean, because a GET tool sends its arguments in the query."
            }
          ],
          "isError": true
        }
      }
    },
    {
      "name": "a non-GET call sends every argument in the body",
      "method": "PUT",
      "path": [
        {
          "text": "/posts/"
        },
        {
          "param": "post",
          "optional": false,
          "catchAll": false
        }
      ],
      "arguments": {
        "post": 3,
        "title": "Hello",
        "tags": [
          "a",
          "b"
        ]
      },
      "expected": {
        "url": "/posts/3",
        "body": {
          "post": 3,
          "title": "Hello",
          "tags": [
            "a",
            "b"
          ]
        }
      }
    }
  ],
  "csrf": [
    {
      "name": "the meta tag's token",
      "meta": "meta-token",
      "cookie": null,
      "expected": {
        "X-CSRF-TOKEN": "meta-token"
      }
    },
    {
      "name": "the cookie's token, decoded",
      "meta": null,
      "cookie": "XSRF-TOKEN=abc%3D%3D; theme=dark",
      "expected": {
        "X-XSRF-TOKEN": "abc=="
      }
    },
    {
      "name": "the meta tag wins over the cookie",
      "meta": "meta-token",
      "cookie": "XSRF-TOKEN=cookie-token",
      "expected": {
        "X-CSRF-TOKEN": "meta-token"
      }
    },
    {
      "name": "an empty meta tag falls back to the cookie",
      "meta": "",
      "cookie": "XSRF-TOKEN=cookie-token",
      "expected": {
        "X-XSRF-TOKEN": "cookie-token"
      }
    },
    {
      "name": "cookies are trimmed before matching",
      "meta": null,
      "cookie": " theme=dark;   XSRF-TOKEN=spaced",
      "expected": {
        "X-XSRF-TOKEN": "spaced"
      }
    },
    {
      "name": "a cookie whose name only ends in the name does not match",
      "meta": null,
      "cookie": "MY-XSRF-TOKEN=wrong; XSRF-TOKEN=right",
      "expected": {
        "X-XSRF-TOKEN": "right"
      }
    },
    {
      "name": "no meta tag and no cookie send no header",
      "meta": null,
      "cookie": "theme=dark",
      "expected": {}
    }
  ],
  "results": [
    {
      "name": "an empty 2xx answer",
      "maxResultBytes": 8388608,
      "response": {
        "status": 204,
        "contentType": null,
        "body": ""
      },
      "expected": {
        "content": [],
        "isError": false
      }
    },
    {
      "name": "a JSON answer",
      "maxResultBytes": 8388608,
      "response": {
        "status": 200,
        "contentType": "application/json",
        "body": "{\"id\":1,\"title\":\"Hello\"}"
      },
      "expected": {
        "content": [
          {
            "type": "text",
            "text": "{\"id\":1,\"title\":\"Hello\"}"
          }
        ],
        "structuredContent": {
          "id": 1,
          "title": "Hello"
        },
        "isError": false
      }
    },
    {
      "name": "a +json answer",
      "maxResultBytes": 8388608,
      "response": {
        "status": 201,
        "contentType": "application/vnd.api+json; charset=utf-8",
        "body": "{\"data\":{\"id\":\"1\"}}"
      },
      "expected": {
        "content": [
          {
            "type": "text",
            "text": "{\"data\":{\"id\":\"1\"}}"
          }
        ],
        "structuredContent": {
          "data": {
            "id": "1"
          }
        },
        "isError": false
      }
    },
    {
      "name": "a 2xx answer that is not JSON",
      "maxResultBytes": 8388608,
      "response": {
        "status": 200,
        "contentType": "text/html; charset=utf-8",
        "body": "<p>Hello</p>"
      },
      "expected": {
        "content": [
          {
            "type": "text",
            "text": "The tool answered with a body that is not JSON."
          }
        ],
        "isError": true
      }
    },
    {
      "name": "a JSON content type with a broken body",
      "maxResultBytes": 8388608,
      "response": {
        "status": 200,
        "contentType": "application/json",
        "body": "{"
      },
      "expected": {
        "content": [
          {
            "type": "text",
            "text": "The tool answered with a body that is not JSON."
          }
        ],
        "isError": true
      }
    },
    {
      "name": "a 2xx answer over the bound",
      "maxResultBytes": 32,
      "response": {
        "status": 200,
        "contentType": "application/json",
        "body": "{\"text\":\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"}"
      },
      "expected": {
        "content": [
          {
            "type": "text",
            "text": "The tool's result is larger than the 32 bytes the page returns."
          }
        ],
        "isError": true
      },
      "browserOnly": true
    },
    {
      "name": "a redirect status",
      "maxResultBytes": 8388608,
      "response": {
        "status": 302,
        "contentType": null,
        "body": ""
      },
      "expected": {
        "content": [
          {
            "type": "text",
            "text": "The tool answered with a redirect, which a tool call cannot follow."
          }
        ],
        "isError": true
      }
    },
    {
      "name": "a redirect the browser did not follow",
      "maxResultBytes": 8388608,
      "response": {
        "status": 0,
        "type": "opaqueredirect",
        "contentType": null,
        "body": ""
      },
      "expected": {
        "content": [
          {
            "type": "text",
            "text": "The tool answered with a redirect, which a tool call cannot follow."
          }
        ],
        "isError": true
      },
      "browserOnly": true
    },
