{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "suprnova/laravel-database-fixtures",
    "type": "project",
    "description": "Laravel 13 app that builds the Suprnova laravel_database test fixtures.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "laravel/pennant": "^1.26",
        "spatie/laravel-permission": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {},
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "suprnova-fixture": {
            "skeleton": "laravel/laravel v13.10.1"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
