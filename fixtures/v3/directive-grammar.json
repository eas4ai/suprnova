{
  "schema_version": 1,
  "contract_version": 1,
  "syntax": {
    "prefix": "live:",
    "target_kinds": ["island", "keyed_scope", "element"],
    "literal_kinds": ["boolean", "integer", "string", "token", "mapping"],
    "argument_forms": ["none", "identifier", "field", "action", "target", "mapping"],
    "fallbacks": ["inert", "native", "retain_dom"]
  },
  "event_modifiers": [
    "prevent",
    "stop",
    "once",
    "self",
    "trusted",
    "capture",
    "enter",
    "escape",
    "space",
    "tab",
    "up",
    "down",
    "left",
    "right"
  ],
  "model_modifiers": [
    "immediate",
    "change",
    "blur",
    "action",
    "submit",
    "debounce.100ms",
    "debounce.250ms",
    "debounce.500ms",
    "throttle.100ms",
    "throttle.250ms",
    "latest",
    "serial",
    "parallel"
  ],
  "feedback_modifiers": ["show", "hide", "class", "disabled", "busy", "live.polite", "live.assertive"],
  "morph_modifiers": ["self", "children", "subtree"],
  "transition_modifiers": ["enter", "leave", "both", "reduced-motion"],
  "navigation_modifiers": ["replace", "transition", "hover", "visible", "eager"],
  "reserved": ["poll", "stream", "upload", "progress"],
  "directives": [
    {"name":"click","owner":"element","value":"action","modifiers":"event","conflicts":[],"phase":"schedule","fallback":"native"},
    {"name":"submit","owner":"element","value":"action","modifiers":"event","conflicts":[],"phase":"schedule","fallback":"native"},
    {"name":"change","owner":"element","value":"action","modifiers":"event","conflicts":[],"phase":"schedule","fallback":"native"},
    {"name":"input","owner":"element","value":"action","modifiers":"event","conflicts":[],"phase":"schedule","fallback":"native"},
    {"name":"keydown","owner":"element","value":"action","modifiers":"event","conflicts":[],"phase":"schedule","fallback":"native"},
    {"name":"init","owner":"element","value":"action","modifiers":[],"conflicts":[],"phase":"schedule","fallback":"inert"},
    {"name":"model","owner":"element","value":"field","modifiers":"model","conflicts":[],"phase":"schedule","fallback":"native"},
    {"name":"url","owner":"island","value":"field","modifiers":["replace"],"conflicts":["navigate"],"phase":"navigation","fallback":"native"},
    {"name":"signal","owner":"keyed_scope","value":"mapping","modifiers":[],"conflicts":[],"phase":"local","fallback":"inert"},
    {"name":"toggle","owner":"element","value":"identifier","modifiers":[],"conflicts":[],"phase":"local","fallback":"inert"},
    {"name":"show","owner":"element","value":"identifier","modifiers":[],"conflicts":[],"phase":"local","fallback":"inert"},
    {"name":"class","owner":"element","value":"mapping","modifiers":[],"conflicts":[],"phase":"local","fallback":"inert"},
    {"name":"attr","owner":"element","value":"mapping","modifiers":[],"conflicts":[],"phase":"local","fallback":"inert"},
    {"name":"selected","owner":"element","value":"identifier","modifiers":[],"conflicts":[],"phase":"local","fallback":"native"},
    {"name":"expanded","owner":"element","value":"identifier","modifiers":[],"conflicts":[],"phase":"local","fallback":"native"},
    {"name":"inert","owner":"element","value":"identifier","modifiers":[],"conflicts":[],"phase":"local","fallback":"native"},
    {"name":"focus","owner":"element","value":"identifier","modifiers":[],"conflicts":[],"phase":"local","fallback":"native"},
    {"name":"idle","owner":"element","value":"target","modifiers":"feedback","conflicts":[],"phase":"feedback","fallback":"inert"},
    {"name":"dirty","owner":"element","value":"target","modifiers":"feedback","conflicts":[],"phase":"feedback","fallback":"inert"},
    {"name":"queued","owner":"element","value":"target","modifiers":"feedback","conflicts":[],"phase":"feedback","fallback":"inert"},
    {"name":"loading","owner":"element","value":"target","modifiers":"feedback","conflicts":[],"phase":"feedback","fallback":"inert"},
    {"name":"validating","owner":"element","value":"target","modifiers":"feedback","conflicts":[],"phase":"feedback","fallback":"inert"},
    {"name":"success","owner":"element","value":"target","modifiers":"feedback","conflicts":[],"phase":"feedback","fallback":"inert"},
    {"name":"interrupted","owner":"element","value":"target","modifiers":"feedback","conflicts":[],"phase":"feedback","fallback":"inert"},
    {"name":"offline","owner":"element","value":"target","modifiers":"feedback","conflicts":[],"phase":"feedback","fallback":"inert"},
    {"name":"retrying","owner":"element","value":"target","modifiers":"feedback","conflicts":[],"phase":"feedback","fallback":"inert"},
    {"name":"error","owner":"element","value":"target","modifiers":"feedback","conflicts":[],"phase":"feedback","fallback":"inert"},
    {"name":"effect","owner":"island","value":"identifier","modifiers":[],"conflicts":[],"phase":"local","fallback":"inert"},
    {"name":"on","owner":"element","value":"mapping","modifiers":"event","conflicts":[],"phase":"local","fallback":"inert"},
    {"name":"call","owner":"element","value":"identifier","modifiers":[],"conflicts":[],"phase":"local","fallback":"inert"},
    {"name":"component","owner":"island","value":"identifier","modifiers":[],"conflicts":[],"phase":"morph","fallback":"retain_dom"},
    {"name":"key","owner":"keyed_scope","value":"identifier","modifiers":[],"conflicts":[],"phase":"morph","fallback":"retain_dom"},
    {"name":"lazy","owner":"island","value":"empty","modifiers":["visible","eager"],"conflicts":[],"phase":"schedule","fallback":"native"},
    {"name":"preserve","owner":"element","value":"empty","modifiers":"morph","conflicts":["ignore","replace"],"phase":"morph","fallback":"retain_dom"},
    {"name":"ignore","owner":"element","value":"empty","modifiers":"morph","conflicts":["preserve","replace"],"phase":"morph","fallback":"retain_dom"},
    {"name":"replace","owner":"element","value":"empty","modifiers":"morph","conflicts":["preserve","ignore"],"phase":"morph","fallback":"retain_dom"},
    {"name":"persist","owner":"element","value":"identifier","modifiers":[],"conflicts":[],"phase":"morph","fallback":"retain_dom"},
    {"name":"teleport","owner":"element","value":"target","modifiers":[],"conflicts":[],"phase":"morph","fallback":"retain_dom"},
    {"name":"transition","owner":"element","value":"identifier","modifiers":"transition","conflicts":[],"phase":"morph","fallback":"native"},
    {"name":"navigate","owner":"element","value":"empty","modifiers":"navigation","conflicts":["url"],"phase":"navigation","fallback":"native"},
    {"name":"prefetch","owner":"element","value":"empty","modifiers":"navigation","conflicts":[],"phase":"navigation","fallback":"native"}
  ]
}
