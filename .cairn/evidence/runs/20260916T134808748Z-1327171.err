    <input class="sn-input" id="email" name="email" type="email" placeholder="" autocomplete="email" aria-describedby="email-hint email-error" required live:model="email">

    <p class="sn-hint" id="email-hint">We never share it.</p>
    <output class="sn-error" id="email-error" live:error.live.polite="email"></output>
    </div>


