    </div>


    <div class="sn-field" data-sn-field="country">
    <label class="sn-label" for="country">Country</label>

    <select class="sn-select" id="country" name="country" aria-describedby="country-hint country-error" live:model="country">
    <option value="">Choose a country</option>

    <option value="ca">Canada</option>

    <option value="us">United States</option>

    </select>

    <p class="sn-hint" id="country-hint"></p>
    <output class="sn-error" id="country-error" live:error.live.polite="country"></output>
