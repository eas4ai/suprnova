    <input class="sn-input sn-number-input" id="quantity" name="quantity" type="number" inputmode="decimal" min="1" max="50" step="1" aria-describedby="quantity-hint quantity-error" live:model="quantity">

    <p class="sn-hint" id="quantity-hint"></p>
    <output class="sn-error" id="quantity-error" live:error.live.polite="quantity"></output>
    </div>


    <div class="sn-field" data-sn-field="volume">
    <label class="sn-label" for="volume">Volume</label>

    <div class="sn-slider">
