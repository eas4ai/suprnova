    <sn-password-reveal class="sn-password">
    <input class="sn-input sn-password-input" id="secret" name="secret" type="password" autocomplete="new-password" aria-describedby="secret-hint secret-error" required live:model="secret">
    <button class="sn-password-toggle" type="button" aria-controls="secret" aria-pressed="false">Show</button>
    </sn-password-reveal>

    <p class="sn-hint" id="secret-hint"></p>
