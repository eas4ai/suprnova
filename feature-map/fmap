#!/usr/bin/env python3
r"""fmap: query and update the Suprnova feature map.

The surface (feature-map/surface.jsonl) is every public item extracted from
the source, filed under the manual chapter that owns it. The state
(feature-map/state.jsonl) is the remediation record: what has been checked
against the source, when, and at which signature. Both load into an
in-memory SQLite database on every call; nothing else is stored.

Every command prints JSON. Statuses:

  todo         nothing recorded yet
  in_progress  someone is working on it
  done         the manual matches the source for this item
  skip         deliberately not documented (the note says why)
  stale        was done, but the item's signature has changed since

Examples:

  fmap summary                          progress per chapter
  fmap next --chapter queues --limit 20 top-level items still to do
  fmap show suprnova::Queue             one item, its members and its state
  fmap chapter queues --status stale    items in a chapter by status
  fmap search retry_failed              ids containing a string
  fmap query "SELECT id FROM items WHERE feature LIKE '%off by default%'"
  fmap mark suprnova::Queue --children --status done --note "<where in queues.md>"
  fmap orphans                          state for items the source no longer has

Laravel parity (feature-map/laravel/): every public piece of laravel/framework
at the pinned version, filed under its docs page, and the Suprnova items that
implement each one (recorded in laravel/parity.jsonl).

  fmap laravel summary                  parity progress per Laravel docs page
  fmap laravel next --page queues       Laravel items with no parity decision yet
  fmap laravel show 'Illuminate\Support\Facades\Cache::remember'
  fmap laravel search rememberForever
  fmap parity 'Illuminate\Support\Facades\Cache::remember' --status shipped --suprnova suprnova::Cache::remember
  fmap parity 'Illuminate\...' --status by_design_no --note "why"
  fmap parity-check                     links whose Laravel or Suprnova side changed or vanished
  fmap exclusive --chapter cache        Suprnova items no Laravel item maps to

Parity statuses: shipped, diverged (both need --suprnova), not_built,
by_design_no, not_applicable (both of the last two need --note). Computed:
unmapped (nothing recorded), stale (either side's signature changed since the
link was recorded), broken (a linked Suprnova item no longer exists).
"""
import argparse
import datetime
import json
import sqlite3
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
SURFACE = HERE / "surface.jsonl"
STATE = HERE / "state.jsonl"
META = HERE / "meta.json"
STATUSES = ("todo", "in_progress", "done", "skip")
LARAVEL = HERE / "laravel"
L_SURFACE = LARAVEL / "surface.jsonl"
L_PARITY = LARAVEL / "parity.jsonl"
L_META = LARAVEL / "meta.json"
PARITY = ("shipped", "diverged", "not_built", "by_design_no", "not_applicable")

SCHEMA = """
CREATE TABLE surface (
  id TEXT PRIMARY KEY, kind TEXT, family TEXT, crate TEXT, module TEXT, chapter TEXT,
  parent TEXT, file TEXT, line INTEGER, feature TEXT, deprecated INTEGER, hidden INTEGER,
  sig_hash TEXT, body_hash TEXT, record TEXT);
CREATE TABLE state (
  id TEXT PRIMARY KEY, status TEXT, note TEXT, verified_rev TEXT,
  verified_sig_hash TEXT, verified_body_hash TEXT, updated_at TEXT);
CREATE VIEW items AS
SELECT s.id, s.kind, s.family, s.crate, s.module, s.chapter, s.parent, s.file, s.line,
       s.feature, s.deprecated, s.hidden, s.sig_hash, s.body_hash,
       CASE
         WHEN st.status IS NULL THEN 'todo'
         WHEN st.status = 'done' AND st.verified_sig_hash IS NOT s.sig_hash THEN 'stale'
         ELSE st.status
       END AS status,
       COALESCE(st.status = 'done' AND st.verified_sig_hash IS s.sig_hash
        AND st.verified_body_hash IS NOT s.body_hash, 0) AS body_changed,
       st.note, st.verified_rev, st.updated_at
FROM surface s LEFT JOIN state st ON st.id = s.id;

CREATE TABLE lsurface (
  id TEXT PRIMARY KEY, kind TEXT, family TEXT, component TEXT, namespace TEXT, page TEXT,
  parent TEXT, file TEXT, line INTEGER, deprecated INTEGER, sig_hash TEXT, body_hash TEXT, record TEXT);
CREATE TABLE parity (
  laravel_id TEXT PRIMARY KEY, status TEXT, note TEXT, laravel_sig_hash TEXT,
  laravel_version TEXT, suprnova_rev TEXT, updated_at TEXT);
CREATE TABLE parity_links (laravel_id TEXT, suprnova_id TEXT, suprnova_sig_hash TEXT);
CREATE VIEW links AS
SELECT pl.laravel_id, pl.suprnova_id, s.id IS NULL AS missing,
       s.id IS NOT NULL AND pl.suprnova_sig_hash IS NOT s.sig_hash AS changed
FROM parity_links pl LEFT JOIN surface s ON s.id = pl.suprnova_id;
CREATE VIEW laravel_items AS
SELECT l.id, l.kind, l.family, l.component, l.namespace, l.page, l.parent, l.file, l.line, l.deprecated,
       l.sig_hash,
       CASE
         WHEN p.laravel_id IS NULL THEN 'unmapped'
         WHEN EXISTS (SELECT 1 FROM links k WHERE k.laravel_id = l.id AND k.missing) THEN 'broken'
         WHEN p.laravel_sig_hash IS NOT l.sig_hash
           OR EXISTS (SELECT 1 FROM links k WHERE k.laravel_id = l.id AND k.changed) THEN 'stale'
         ELSE p.status
       END AS parity,
       p.status AS recorded_parity,
       (SELECT json_group_array(suprnova_id) FROM parity_links k WHERE k.laravel_id = l.id) AS suprnova,
       p.note AS parity_note, p.updated_at AS parity_updated_at
FROM lsurface l LEFT JOIN parity p ON p.laravel_id = l.id;
"""


def load():
    db = sqlite3.connect(":memory:")
    db.row_factory = sqlite3.Row
    db.executescript(SCHEMA)
    for line in SURFACE.read_text().splitlines():
        r = json.loads(line)
        db.execute("INSERT INTO surface VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", (
            r["id"], r["kind"], r["family"], r.get("crate"), r.get("module"), r["chapter"], r.get("parent"),
            r.get("file"), r.get("line"), r.get("feature"), int(bool(r.get("deprecated"))), int(bool(r.get("hidden"))),
            r.get("sig_hash"), r.get("body_hash"), line))
    if L_SURFACE.exists():
        for line in L_SURFACE.read_text().splitlines():
            r = json.loads(line)
            db.execute("INSERT INTO lsurface VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)", (
                r["id"], r["kind"], r["family"], r.get("component"), r.get("namespace"), r["page"], r.get("parent"),
                r.get("file"), r.get("line"), int(bool(r.get("deprecated"))), r.get("sig_hash"), r.get("body_hash"), line))
    if L_PARITY.exists():
        for line in L_PARITY.read_text().splitlines():
            if line.strip():
                p = json.loads(line)
                db.execute("INSERT INTO parity VALUES (?,?,?,?,?,?,?)", (
                    p["laravel_id"], p["status"], p.get("note"), p.get("laravel_sig_hash"),
                    p.get("laravel_version"), p.get("suprnova_rev"), p.get("updated_at")))
                for sid, h in (p.get("suprnova") or {}).items():
                    db.execute("INSERT INTO parity_links VALUES (?,?,?)", (p["laravel_id"], sid, h))
    if STATE.exists():
        for line in STATE.read_text().splitlines():
            if line.strip():
                s = json.loads(line)
                db.execute("INSERT INTO state VALUES (?,?,?,?,?,?,?)", (
                    s["id"], s["status"], s.get("note"), s.get("verified_rev"),
                    s.get("verified_sig_hash"), s.get("verified_body_hash"), s.get("updated_at")))
    return db


def save_state(db):
    rows = db.execute("SELECT * FROM state ORDER BY id").fetchall()
    STATE.write_text("".join(json.dumps({k: r[k] for k in r.keys() if r[k] is not None}, sort_keys=True) + "\n"
                             for r in rows))


def save_parity(db):
    out = []
    for p in db.execute("SELECT * FROM parity ORDER BY laravel_id").fetchall():
        rec = {k: p[k] for k in p.keys() if p[k] is not None}
        links = {r[0]: r[1] for r in db.execute(
            "SELECT suprnova_id, suprnova_sig_hash FROM parity_links WHERE laravel_id = ? ORDER BY suprnova_id",
            [p["laravel_id"]])}
        if links:
            rec["suprnova"] = links
        out.append(json.dumps(rec, sort_keys=True) + "\n")
    L_PARITY.write_text("".join(out))


def current_source_rev():
    meta = json.loads(META.read_text())
    try:
        return subprocess.run(["git", "-C", str(HERE.parent), "log", "-1", "--format=%h", "--",
                               *meta["source_paths"]], capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None


def freshness():
    """Warn when the source has moved past the commit the surface was built from."""
    built = json.loads(META.read_text())["source_rev"]
    now = current_source_rev()
    if now and now != built:
        return {"warning": f"surface built from {built} but source is now at {now}; "
                           "run feature-map/tools/generate.sh before trusting results"}
    return {}


def rows(cur):
    return [dict(r) for r in cur.fetchall()]


def emit(obj):
    try:
        json.dump(obj, sys.stdout, indent=1, default=str)
        sys.stdout.write("\n")
        sys.stdout.flush()
    except BrokenPipeError:  # output piped into head or similar
        sys.stdout = open("/dev/null", "w")


def cmd_summary(db, a):
    per = rows(db.execute("""
        SELECT chapter, COUNT(*) AS items,
               SUM(status='done') AS done, SUM(status='skip') AS skip, SUM(status='stale') AS stale,
               SUM(status='in_progress') AS in_progress, SUM(status='todo') AS todo
        FROM items GROUP BY chapter ORDER BY chapter LIKE '(%', chapter"""))
    total = rows(db.execute("SELECT COUNT(*) AS items, SUM(status IN ('done','skip')) AS finished FROM items"))[0]
    emit({**freshness(), "total": total, "chapters": per})


def cmd_chapter(db, a):
    sql = "SELECT id, kind, parent, file, line, status, feature, note FROM items WHERE chapter = ?"
    args = [a.name]
    if a.status:
        sql += " AND status = ?"
        args.append(a.status)
    if a.top:
        sql += " AND parent IS NULL"
    sql += " ORDER BY module, id LIMIT ?"
    args.append(a.limit)
    found = rows(db.execute(sql, args))
    if not found and not db.execute("SELECT 1 FROM items WHERE chapter = ?", [a.name]).fetchone():
        emit({"error": f"no chapter named {a.name!r}",
              "chapters": [r[0] for r in db.execute("SELECT DISTINCT chapter FROM items ORDER BY 1")]})
        sys.exit(1)
    emit({**freshness(), "chapter": a.name, "items": found})


def cmd_next(db, a):
    sql = "SELECT id, kind, chapter, file, line, feature FROM items WHERE parent IS NULL AND status IN ('todo','stale')"
    args = []
    if a.chapter:
        sql += " AND chapter = ?"
        args.append(a.chapter)
    sql += " ORDER BY chapter LIKE '(%', chapter, module, id LIMIT ?"
    args.append(a.limit)
    emit({**freshness(), "items": rows(db.execute(sql, args))})


def cmd_show(db, a):
    r = db.execute("SELECT * FROM items WHERE id = ?", [a.id]).fetchone()
    if r is None:
        near = [x[0] for x in db.execute("SELECT id FROM items WHERE id LIKE ? LIMIT 10", [f"%{a.id}%"])]
        emit({"error": f"no item {a.id!r}", "similar": near})
        sys.exit(1)
    record = json.loads(db.execute("SELECT record FROM surface WHERE id = ?", [a.id]).fetchone()[0])
    children = rows(db.execute("SELECT id, kind, file, line, status FROM items WHERE parent = ? ORDER BY id", [a.id]))
    laravel = rows(db.execute("SELECT laravel_id FROM parity_links WHERE suprnova_id = ? ORDER BY 1", [a.id]))
    state = {k: r[k] for k in ("status", "note", "verified_rev", "updated_at")}
    state["laravel_equivalents"] = [x["laravel_id"] for x in laravel]
    state["body_changed"] = bool(r["body_changed"])
    emit({**freshness(), "item": {**record, **state},
          "members": children})


def cmd_search(db, a):
    emit({"items": rows(db.execute("SELECT id, kind, chapter, status FROM items WHERE id LIKE ? ORDER BY id LIMIT ?",
                                   [f"%{a.text}%", a.limit]))})


def cmd_stale(db, a):
    sql = "SELECT id, chapter, file, line, verified_rev FROM items WHERE status = 'stale'"
    if a.body:
        sql += " OR body_changed"
    emit({**freshness(), "items": rows(db.execute(sql + " ORDER BY chapter, id"))})


def cmd_orphans(db, a):
    emit({"orphans": rows(db.execute(
        "SELECT st.* FROM state st LEFT JOIN surface s ON s.id = st.id WHERE s.id IS NULL ORDER BY st.id"))})


def cmd_query(db, a):
    if not a.sql.lstrip().lower().startswith(("select", "with")):
        emit({"error": "query is read-only; use `fmap mark` to change state"})
        sys.exit(1)
    emit({"rows": rows(db.execute(a.sql))})


def cmd_mark(db, a):
    if a.status == "skip" and not a.note:
        emit({"error": "skip needs --note saying why the item is not documented"})
        sys.exit(1)
    fresh = freshness()
    if fresh and a.status == "done":
        emit({"error": fresh["warning"]})
        sys.exit(1)
    ids = list(a.ids)
    missing = [i for i in ids if not db.execute("SELECT 1 FROM surface WHERE id = ?", [i]).fetchone()]
    if missing:
        emit({"error": "unknown ids", "ids": missing})
        sys.exit(1)
    if a.children:
        for i in list(ids):
            ids += [r[0] for r in db.execute("SELECT id FROM surface WHERE parent = ?", [i])]
    rev = json.loads(META.read_text())["source_rev"]
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    for i in dict.fromkeys(ids):
        sig, body = db.execute("SELECT sig_hash, body_hash FROM surface WHERE id = ?", [i]).fetchone()
        if a.status == "todo":
            db.execute("DELETE FROM state WHERE id = ?", [i])
            continue
        db.execute("INSERT OR REPLACE INTO state VALUES (?,?,?,?,?,?,?)", (
            i, a.status, a.note, rev, sig, body, now))
    save_state(db)
    emit({"marked": len(dict.fromkeys(ids)), "status": a.status})


# ---- Laravel side and parity -------------------------------------------------------

def lfresh():
    return {"laravel": json.loads(L_META.read_text())["laravel_version"]} if L_META.exists() else {
        "error": "no Laravel surface; run feature-map/tools/laravel/generate.sh"}


def cmd_laravel(db, a):
    if not L_SURFACE.exists():
        emit(lfresh())
        sys.exit(1)
    if a.lcmd == "summary":
        emit({**lfresh(), "pages": rows(db.execute("""
            SELECT page, COUNT(*) AS items, SUM(parity='unmapped') AS unmapped, SUM(parity='shipped') AS shipped,
                   SUM(parity='diverged') AS diverged, SUM(parity='not_built') AS not_built,
                   SUM(parity='by_design_no') AS by_design_no, SUM(parity='not_applicable') AS not_applicable,
                   SUM(parity IN ('stale','broken')) AS needs_recheck
            FROM laravel_items GROUP BY page ORDER BY page LIKE '(%', page"""))})
    elif a.lcmd == "next":
        sql = "SELECT id, kind, page, file, line FROM laravel_items WHERE parent IS NULL AND parity IN ('unmapped','stale','broken')"
        args = []
        if a.page:
            sql += " AND page = ?"
            args.append(a.page)
        if a.kind:
            sql += " AND kind = ?"
            args.append(a.kind)
        emit({**lfresh(), "items": rows(db.execute(sql + " ORDER BY page, id LIMIT ?", args + [a.limit]))})
    elif a.lcmd == "show":
        r = db.execute("SELECT * FROM laravel_items WHERE id = ?", [a.id]).fetchone()
        if r is None:
            near = [x[0] for x in db.execute("SELECT id FROM lsurface WHERE id LIKE ? LIMIT 10", [f"%{a.id}%"])]
            emit({"error": f"no Laravel item {a.id!r}", "similar": near})
            sys.exit(1)
        record = json.loads(db.execute("SELECT record FROM lsurface WHERE id = ?", [a.id]).fetchone()[0])
        links = rows(db.execute("""SELECT k.suprnova_id, k.missing, k.changed, i.kind, i.file, i.line, i.chapter
                                   FROM links k LEFT JOIN items i ON i.id = k.suprnova_id WHERE k.laravel_id = ?""", [a.id]))
        members = rows(db.execute("SELECT id, kind, parity FROM laravel_items WHERE parent = ? ORDER BY id", [a.id]))
        emit({**lfresh(), "item": {**record, "parity": r["parity"], "parity_note": r["parity_note"],
                                   "suprnova": links}, "members": members})
    elif a.lcmd == "search":
        emit({"items": rows(db.execute("SELECT id, kind, page, parity FROM laravel_items WHERE id LIKE ? ORDER BY id LIMIT ?",
                                       [f"%{a.text}%", a.limit]))})


def cmd_parity(db, a):
    if not L_SURFACE.exists():
        emit(lfresh())
        sys.exit(1)
    if a.status in ("shipped", "diverged") and not a.suprnova:
        emit({"error": f"{a.status} needs --suprnova naming the Suprnova items that implement it"})
        sys.exit(1)
    if a.status in ("by_design_no", "not_applicable") and not a.note:
        emit({"error": f"{a.status} needs --note saying why"})
        sys.exit(1)
    if a.status in ("not_built", "by_design_no", "not_applicable") and a.suprnova:
        emit({"error": f"{a.status} means there is no Suprnova equivalent; drop --suprnova"})
        sys.exit(1)
    fresh = freshness()
    if fresh:
        emit({"error": fresh["warning"]})
        sys.exit(1)
    ids = list(a.ids)
    bad = [i for i in ids if not db.execute("SELECT 1 FROM lsurface WHERE id = ?", [i]).fetchone()]
    if bad:
        emit({"error": "unknown Laravel ids", "ids": bad})
        sys.exit(1)
    sup = {}
    for sid in a.suprnova or []:
        row = db.execute("SELECT sig_hash FROM surface WHERE id = ?", [sid]).fetchone()
        if row is None:
            stem = sid.split("::")[-1]
            stem = stem[:max(4, len(stem) - 2)]
            near = [x[0] for x in db.execute("SELECT id FROM surface WHERE id LIKE ? ORDER BY length(id) LIMIT 10",
                                             [f"%{stem}%"])]
            emit({"error": f"unknown Suprnova id {sid!r}", "similar": near})
            sys.exit(1)
        sup[sid] = row[0]
    if a.children:
        for i in list(ids):
            ids += [r[0] for r in db.execute("SELECT id FROM lsurface WHERE parent = ?", [i])]
    version = json.loads(L_META.read_text())["laravel_version"]
    rev = json.loads(META.read_text())["source_rev"]
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    for i in dict.fromkeys(ids):
        db.execute("DELETE FROM parity_links WHERE laravel_id = ?", [i])
        if a.status == "unmapped":
            db.execute("DELETE FROM parity WHERE laravel_id = ?", [i])
            continue
        lsig = db.execute("SELECT sig_hash FROM lsurface WHERE id = ?", [i]).fetchone()[0]
        db.execute("INSERT OR REPLACE INTO parity VALUES (?,?,?,?,?,?,?)", (i, a.status, a.note, lsig, version, rev, now))
        for sid, h in sup.items():
            db.execute("INSERT INTO parity_links VALUES (?,?,?)", (i, sid, h))
    save_parity(db)
    emit({"recorded": len(dict.fromkeys(ids)), "status": a.status, "suprnova": list(sup)})


def cmd_parity_import(db, a):
    """Apply a JSONL file of parity decisions, one {laravel_id, status, suprnova?, note?} per line,
    under the same rules as `fmap parity`. Every problem is reported; nothing is written unless
    the whole file is valid."""
    if not L_SURFACE.exists():
        emit(lfresh())
        sys.exit(1)
    fresh = freshness()
    if fresh:
        emit({"error": fresh["warning"]})
        sys.exit(1)
    recs = [json.loads(l) for l in Path(a.file).read_text().splitlines() if l.strip()]
    problems, plan = [], []
    for n, r in enumerate(recs, 1):
        lid, st, sup, note = r.get("laravel_id"), r.get("status"), r.get("suprnova") or [], r.get("note")
        err = None
        if st not in PARITY:
            err = f"unknown status {st!r}"
        elif not db.execute("SELECT 1 FROM lsurface WHERE id = ?", [lid]).fetchone():
            err = "unknown Laravel id"
        elif st in ("shipped", "diverged") and not sup:
            err = f"{st} needs suprnova ids"
        elif st in ("by_design_no", "not_applicable") and not note:
            err = f"{st} needs a note"
        elif st in ("not_built", "by_design_no", "not_applicable") and sup:
            err = f"{st} takes no suprnova ids"
        links = {}
        for sid in sup:
            row = db.execute("SELECT sig_hash FROM surface WHERE id = ?", [sid]).fetchone()
            if row is None:
                err = err or f"unknown Suprnova id {sid!r}"
            else:
                links[sid] = row[0]
        if err:
            problems.append({"line": n, "laravel_id": lid, "error": err})
        else:
            plan.append((lid, st, note, links))
    dup = [lid for lid, c in __import__("collections").Counter(p[0] for p in plan).items() if c > 1]
    problems += [{"laravel_id": lid, "error": "decided more than once"} for lid in dup]
    if problems:
        emit({"error": f"{len(problems)} invalid records; nothing written", "problems": problems})
        sys.exit(1)
    if a.dry_run:
        emit({"valid": len(plan), "by_status": dict(__import__("collections").Counter(p[1] for p in plan))})
        return
    version = json.loads(L_META.read_text())["laravel_version"]
    rev = json.loads(META.read_text())["source_rev"]
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    for lid, st, note, links in plan:
        db.execute("DELETE FROM parity_links WHERE laravel_id = ?", [lid])
        lsig = db.execute("SELECT sig_hash FROM lsurface WHERE id = ?", [lid]).fetchone()[0]
        db.execute("INSERT OR REPLACE INTO parity VALUES (?,?,?,?,?,?,?)", (lid, st, note, lsig, version, rev, now))
        for sid, h in links.items():
            db.execute("INSERT INTO parity_links VALUES (?,?,?)", (lid, sid, h))
    save_parity(db)
    emit({"recorded": len(plan), "by_status": dict(__import__("collections").Counter(p[1] for p in plan))})


def cmd_parity_check(db, a):
    emit({**lfresh(), "needs_recheck": rows(db.execute(
        "SELECT id, page, parity, recorded_parity, suprnova FROM laravel_items WHERE parity IN ('stale','broken') ORDER BY page, id"))})


def cmd_exclusive(db, a):
    sql = """SELECT i.id, i.kind, i.chapter FROM items i WHERE i.parent IS NULL AND i.kind != 'reexport'
             AND NOT EXISTS (SELECT 1 FROM parity_links k WHERE k.suprnova_id = i.id
                             OR k.suprnova_id IN (SELECT id FROM surface WHERE parent = i.id))"""
    args = []
    if a.chapter:
        sql += " AND i.chapter = ?"
        args.append(a.chapter)
    emit({"note": "top-level Suprnova items no Laravel item links to (Suprnova-exclusive, or not mapped yet)",
          "items": rows(db.execute(sql + " ORDER BY i.chapter, i.id LIMIT ?", args + [a.limit]))})


def main():
    ap = argparse.ArgumentParser(prog="fmap", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("summary", help="progress per chapter")
    p = sub.add_parser("chapter", help="items filed under one chapter")
    p.add_argument("name")
    p.add_argument("--status", choices=STATUSES + ("stale",))
    p.add_argument("--top", action="store_true", help="top-level items only, no members")
    p.add_argument("--limit", type=int, default=500)
    p = sub.add_parser("next", help="top-level items still to do (todo or stale)")
    p.add_argument("--chapter")
    p.add_argument("--limit", type=int, default=25)
    p = sub.add_parser("show", help="one item with its members and state")
    p.add_argument("id")
    p = sub.add_parser("search", help="ids containing a string")
    p.add_argument("text")
    p.add_argument("--limit", type=int, default=50)
    p = sub.add_parser("stale", help="done items whose signature changed since they were verified")
    p.add_argument("--body", action="store_true", help="also items whose body changed")
    sub.add_parser("orphans", help="state for items the source no longer has")
    p = sub.add_parser("query", help="read-only SQL over the `items` view")
    p.add_argument("sql")
    p = sub.add_parser("mark", help="record remediation status")
    p.add_argument("ids", nargs="+")
    p.add_argument("--status", required=True, choices=STATUSES)
