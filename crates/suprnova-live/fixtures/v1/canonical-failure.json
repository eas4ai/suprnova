{
  "schema_version": 1,
  "cases": [
    {
      "id": "duplicate-key",
      "input": "{\"a\":1,\"a\":2}",
      "expected_error": "duplicate_key"
    },
    {
      "id": "unsafe-integer",
      "input": "9007199254740992",
      "expected_error": "invalid_number"
    },
    {
      "id": "trailing-data",
      "input": "{} true",
      "expected_error": "invalid_json"
    },
    {
      "id": "non-json-whitespace",
      "input": "\u00a0null",
      "expected_error": "invalid_json"
    },
    {
      "id": "lone-surrogate-escape",
      "input": "\"\\ud800\"",
      "expected_error": "invalid_json"
    },
    {
      "id": "depth-33",
      "input": "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]",
      "expected_error": "input_too_deep"
    }
  ]
}
