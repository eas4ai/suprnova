# Generated by Cargo
# will have compiled files and executables
/debug/
/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Standalone reference catalog and generated build/runtime artifacts
/reference/
/browser/node_modules/
/fuzz/target/
/fuzz/artifacts/
/fuzz/corpus/*/
!/fuzz/corpus/directive_contract/
!/fuzz/corpus/browser_metadata/
!/fuzz/corpus/upload_media_header/
/fuzz/corpus/directive_contract/*
!/fuzz/corpus/directive_contract/valid-click
!/fuzz/corpus/directive_contract/valid-model
!/fuzz/corpus/directive_contract/rejected-reserved
!/fuzz/corpus/directive_contract/rejected-dynamic
/fuzz/corpus/browser_metadata/*
!/fuzz/corpus/browser_metadata/valid-instance-shape
!/fuzz/corpus/browser_metadata/valid-seed-shape
!/fuzz/corpus/browser_metadata/rejected-executable
/fuzz/corpus/upload_media_header/*
!/fuzz/corpus/upload_media_header/truncated-png.hex
!/fuzz/corpus/upload_media_header/truncated-gif.hex
!/fuzz/corpus/upload_media_header/truncated-webp.hex
!/fuzz/corpus/upload_media_header/malformed-jpeg-markers.hex
/benchmarks/local/
/tests/fixtures/compile/target/
/tests/fixtures/compile/*/target/
/.worktrees/

# Agent workspace artifacts (development process, never published)
/.agents/
/.claude/
/.codex/
/.remember/
/skills-lock.json
