# Benchmark SUT image — the dogfood app, backend only.
#
# Distinct from `suprnova-cli/src/templates/files/docker/Dockerfile*.tpl`,
# which build a *scaffolded* project. This builds `app/`, a member of the
# framework workspace, so the build context is the repo root and the whole
# workspace has to be present for cargo to resolve it.
#
# The frontend stage is not optional, even though Phase 1 renders no page.
# `Inertia::install` fails closed under `APP_ENV=production` when there is
# no Vite manifest — deliberately, so a production deploy cannot silently
# serve a stale asset path — and the app panics at bootstrap without one.
# The alternatives were both worse: dropping to `APP_ENV=development`
# would measure a configuration nobody deploys, and stubbing a fake
# manifest would put a lie in the harness. So the image carries the real
# built frontend, which Phase 2 needs regardless.
FROM node:22-bookworm-slim AS frontend

WORKDIR /build/app/frontend
COPY app/frontend/package.json app/frontend/package-lock.json ./
RUN npm ci
COPY app/frontend/ ./
# The full `build` script, svelte-check included: a type error here would
# mean the dogfood frontend does not match the props the Rust side emits,
# and that is worth failing an image build over.
RUN npm run build

# ---------------------------------------------------------------------

# Pinned to the workspace MSRV rather than `rust:latest` so the image is
# reproducible and matches what the gate compiles with.
FROM rust:1.91.1-slim-bookworm AS builder

# Half the benchmark host's threads. The box carries live deployments, and
# an unbounded rustc will take every core it can see — build time is not
# what this harness measures, so there is nothing to win by racing the
# workloads the machine actually exists to run.
ARG CARGO_JOBS=16
ENV CARGO_BUILD_JOBS=${CARGO_JOBS}

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# The workspace is a git dependency consumer (torii, opendal, apple), so
# cargo needs git at build time.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# `--locked` so the image cannot silently drift from the committed
# lockfile; a benchmark whose dependency graph is resolved fresh at build
# time is not measuring the code under test.
#
# Both binaries. `app` is the server, the migrator, and every daemon
# (`queue:work`, `schedule:work`); `console` is what dispatches the
# `#[command]` handlers, which is where the Phase 1 enqueue and verify
# commands live. An image carrying only `app` can run the experiments but
# cannot set them up or check them.
RUN cargo build --release --locked -p app --bin app --bin console

# ---------------------------------------------------------------------

FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Unprivileged: the SUT is about to be pointed at by a load generator and
# a slowloris probe, and nothing it does needs root.
RUN useradd --system --create-home --uid 10001 suprnova

WORKDIR /app
COPY --from=builder /build/target/release/app /usr/local/bin/app
COPY --from=builder /build/target/release/console /usr/local/bin/console

# Vite writes to `app/public/assets` (outDir in vite.config.ts) and the
# manifest under `.vite/` inside it. The app resolves that path relative
# to its working directory, which is why this lands at /app/public.
COPY --from=frontend /build/app/public /app/public

# The app auto-migrates on boot and writes uploads under storage/.
RUN mkdir -p /app/storage && chown -R suprnova:suprnova /app

USER suprnova
EXPOSE 8080

# `/_suprnova/health` is the framework's built-in liveness endpoint — the
# app registers no route of its own for this. Deliberately the plain path
# rather than `/health/ready`: the ready variant probes the database, and
# a DB blip should not mark a server unhealthy when it is merely busy.
#
# A 60s interval, not 10s: the healthcheck is a request the load generator
# did not send, and during a throughput run it lands in the same latency
# histogram as the traffic under test.
HEALTHCHECK --interval=60s --timeout=3s --start-period=40s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8080/_suprnova/health || exit 1

CMD ["app", "serve"]
